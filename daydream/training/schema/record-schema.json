{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daydream training-record (JSONL) schema v2",
  "description": "Per-finding training records projected offline from immutable run and eligible observation snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "tier",
    "session_id",
    "trajectory_id",
    "task_segment",
    "finding_fingerprint",
    "disposition",
    "profile",
    "stack",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of versioned record-snapshot-v1 source identity, run_id, trajectory_id, segment_id, and host item_uid."
    },
    "record_type": {
      "enum": [
        "outcome-finding",
        "process-trace",
        "task-only"
      ]
    },
    "tier": {
      "enum": [
        "gold",
        "silver",
        "task-only"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "trajectory_id": {
      "type": "string"
    },
    "task_segment": {
      "type": "string"
    },
    "finding_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "enum": [
        "accepted",
        "rejected",
        "ambiguous",
        "unanswered",
        "missing"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_schema_version",
        "profile_name",
        "profile_source_kind",
        "profile_digest"
      ],
      "properties": {
        "profile_schema_version": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "profile_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_source_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finding_text": {
      "type": "string",
      "description": "Localized host finding text retained in the run record."
    },
    "finding_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of finding_text."
    },
    "prompt": {
      "type": "string"
    },
    "completion": {
      "type": "string"
    },
    "diff": {
      "type": "string",
      "description": "Immutable analyzed diff retained in original_task.diff."
    },
    "task_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_slug"
      ],
      "properties": {
        "repo_slug": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,}$",
          "description": "Full-length hex sha (40+ chars; sha256-style 64-hex content-address stamps tolerated, matching rft.validate_full_sha)."
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,}$",
          "description": "Full-length hex sha (40+ chars; sha256-style 64-hex content-address stamps tolerated, matching rft.validate_full_sha)."
        },
        "diff_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_ref": {
          "type": "object"
        },
        "replay_verification": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "stack": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hub_commit",
        "content_digests",
        "labeler_policy_version",
        "reply_classifier_version",
        "rubric_schema_version",
        "as_of",
        "valid_at",
        "split",
        "exclusion_reason",
        "repo_slug",
        "license_decision",
        "snapshot_id",
        "source_identity_version"
      ],
      "properties": {
        "hub_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labeler_policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply_classifier_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "holdout"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_ref": {
          "type": "object"
        },
        "repo_slug": {
          "type": "string",
          "minLength": 1
        },
        "license_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_code",
            "spdx_id",
            "policy_version",
            "evidence_ref",
            "repo_slug"
          ],
          "properties": {
            "status": {
              "enum": [
                "admitted",
                "rejected"
              ]
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "spdx_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy_version": {
              "type": "string"
            },
            "evidence_ref": {
              "type": "string"
            },
            "repo_slug": {
              "type": "string"
            }
          }
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_identity_version": {
          "const": "record-snapshot-v1"
        }
      }
    },
    "reward_version": {
      "type": "string"
    },
    "intrinsic_reward": {
      "type": "object"
    },
    "annotation": {
      "type": "object"
    },
    "has_posterior": {
      "type": "boolean"
    },
    "decisive_only": {
      "type": "boolean"
    },
    "decisive_mix": {
      "type": "boolean"
    },
    "verification": {
      "type": "object"
    },
    "scoring": {
      "type": "object"
    },
    "item_uid": {
      "type": "string",
      "minLength": 1
    }
  }
}
