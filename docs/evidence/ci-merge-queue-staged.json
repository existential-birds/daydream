{
  "repository": "existential-birds/daydream",
  "ruleset_id": 25094989,
  "settings": {
    "name": "CI merge queue",
    "target": "branch",
    "enforcement": "disabled",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
